# 应用
APP_NAME=enterprise-ai-agent
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# OpenAI / 兼容 API（公司统一配置：在此处填一份公司共享的 API Key）
OPENAI_API_KEY=sk-your-key
# 阿里云百炼（DashScope）OpenAI 兼容端点
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
# Embedding 模型（text-embedding-v3 输出 1024 维）
EMBEDDING_MODEL=text-embedding-v3

# MySQL
DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/agent_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_COLLECTION_NAME=agent_knowledge

# 日志
LOG_LEVEL=INFO
